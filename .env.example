# veile-bot の設定例。コピーして .env を作る (.env はコミットされない)。
# 本番 (GitHub Actions) では Repository secrets に同じ名前で登録する。

# ---- 必須: LINE Messaging API ----
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=

# ---- 任意: Claude による要約 ----
# 未設定でも動く (抽出要約にフォールバック)。
ANTHROPIC_API_KEY=
VEILE_LLM_ENABLED=1
VEILE_LLM_MODEL=claude-opus-5
# low | medium | high | xhigh | max
VEILE_LLM_EFFORT=high

# ---- 任意: ダイジェストの中身 ----
# 使用ソース (カンマ区切り): github_trending,huggingface,note,seed
VEILE_SOURCES=github_trending,huggingface,note,seed
# 興味キーワード。スコアの「関心度」に効く。
VEILE_INTERESTS=agent,エージェント,llm,claude,mcp,rag,local,ローカル,推論,自動化
# 購読する RSS
VEILE_NOTE_FEEDS=https://note.com/humble_bobcat51/rss

# ---- 任意: 選抜チューニング ----
VEILE_MAX_ITEMS=8
VEILE_CANDIDATE_LIMIT=60
VEILE_MIN_SCORE=0.0
VEILE_FRESHNESS_HALF_LIFE_HOURS=36
VEILE_NOVELTY_BONUS=0.25
VEILE_SEEN_TTL_DAYS=21
VEILE_STATE_PATH=state/seen.json

# ---- 任意: HTTP ----
VEILE_HTTP_TIMEOUT=15
VEILE_HTTP_RETRIES=3
